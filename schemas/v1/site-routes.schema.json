{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creeper5261.github.io/schemas/v1/site-routes.schema.json",
  "title": "Site route catalog",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "route": {
      "type": "object",
      "required": ["id", "title", "route", "kind", "source"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "route": { "type": "string", "pattern": "^/" },
        "kind": { "type": "string" },
        "source": { "enum": ["site-routes", "tool-manifest"] }
      },
      "additionalProperties": false
    }
  }
}
