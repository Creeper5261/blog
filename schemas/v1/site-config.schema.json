{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creeper5261.github.io/schemas/v1/site-config.schema.json",
  "title": "Knowledge site configuration",
  "type": "object",
  "required": ["schemaVersion", "roots", "allowedExternalHosts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "roots": {
      "type": "object",
      "required": ["content", "assets", "schemas", "external", "generated"],
      "properties": {
        "content": { "$ref": "#/$defs/relativePath" },
        "assets": { "$ref": "#/$defs/relativePath" },
        "schemas": { "$ref": "#/$defs/relativePath" },
        "external": { "$ref": "#/$defs/relativePath" },
        "generated": { "$ref": "#/$defs/relativePath" }
      },
      "additionalProperties": false
    },
    "allowedExternalHosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9.-]+$"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
