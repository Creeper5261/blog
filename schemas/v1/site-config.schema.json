{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creeper5261.github.io/schemas/v1/site-config.schema.json",
  "title": "Knowledge site configuration",
  "type": "object",
  "required": ["schemaVersion", "roots", "allowedExternalHosts", "assetPolicy", "siteDataPolicy"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "roots": {
      "type": "object",
      "required": ["content", "assets", "schemas", "external", "generated"],
      "properties": {
        "content": { "$ref": "#/$defs/relativePath" },
        "assets": { "$ref": "#/$defs/relativePath" },
        "schemas": { "$ref": "#/$defs/relativePath" },
        "external": { "$ref": "#/$defs/relativePath" },
        "generated": { "$ref": "#/$defs/relativePath" }
      },
      "additionalProperties": false
    },
    "allowedExternalHosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9.-]+$"
      },
      "uniqueItems": true
    },
    "assetPolicy": {
      "type": "object",
      "required": ["metadataFile", "publicPath", "allowedExtensions", "maxBytes", "requireAlt", "requireRights"],
      "properties": {
        "metadataFile": { "$ref": "#/$defs/relativePath" },
        "publicPath": { "type": "string", "pattern": "^/[A-Za-z0-9/_-]*[A-Za-z0-9_-]$" },
        "allowedExtensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "requireAlt": { "type": "boolean" },
        "requireRights": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "siteDataPolicy": {
      "type": "object",
      "required": ["releaseRetention", "immutableCacheControl", "mutableCacheControl"],
      "properties": {
        "releaseRetention": { "type": "integer", "minimum": 2, "maximum": 20 },
        "immutableCacheControl": { "$ref": "#/$defs/headerValue" },
        "mutableCacheControl": { "$ref": "#/$defs/headerValue" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "headerValue": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    }
  },
  "additionalProperties": false
}
