{
  "name": "creeper5261-blog-recovered",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm run build:site-data && pnpm run prepare:astro && astro build",
    "generate": "pnpm run build",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.astro',{recursive:true,force:true});fs.rmSync('.astro-static',{recursive:true,force:true})\"",
    "server": "pnpm run build:site-data:incremental && pnpm run prepare:astro && astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "pnpm run test && pnpm run check:maintainability && pnpm run check:content-migration && pnpm run check:content && pnpm run check:explain && pnpm run check:site-data",
    "check:content": "node tools/content-build/build.mjs --check",
    "check:content-migration": "node tools/content-migration/migrate.mjs --check",
    "check:explain": "node tools/explain/compiler.mjs",
    "build:content": "node tools/content-build/build.mjs",
    "check:site-data": "node tools/site-data/build.mjs --check",
    "migrate:content": "node tools/content-migration/migrate.mjs",
    "build:site-data": "node tools/site-data/build.mjs",
    "build:site-data:incremental": "node tools/site-data/build.mjs --mode=incremental",
    "rollback:site-data": "node tools/site-data/rollback.mjs",
    "update:pulse": "node tools/pulse/update.mjs",
    "prepare:astro": "node tools/prepare-astro-assets.mjs && node tools/prepare-github-calendar.mjs",
    "writer": "node tools/writer/server.mjs",
    "publish:latex": "node tools/publish-latex.mjs",
    "publish:latex:acceptance": "node tools/latex-publish-acceptance.mjs",
    "publish:output": "node tools/publish-output.mjs",
    "backup:stats": "node tools/backup-stats.mjs",
    "visual:report": "node tools/visual-compare.mjs",
    "legacy:build": "hexo clean && hexo generate",
    "legacy:generate": "hexo generate",
    "legacy:clean": "hexo clean",
    "legacy:server": "hexo server",
    "legacy:deploy": "hexo deploy",
    "deploy": "astro build",
    "check:maintainability": "node tools/check-maintainability.mjs",
    "recovery:prepare-legacy-pages": "node tools/prepare-astro-legacy-pages.mjs",
    "recovery:note": "node -e \"console.log('Recovery harness lives outside this repo at ../tools in the original workspace.')\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/legacy-modes": "6.5.2",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@unified-latex/unified-latex-ctan": "1.8.4",
    "@unified-latex/unified-latex-util-parse": "1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "1.8.4",
    "compressorjs": "1.3.0",
    "docx": "9.7.1",
    "dompurify": "3.4.13",
    "hexo": "6.3.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^5.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "4.10.0",
    "hexo-wordcount": "^6.0.1",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "katex": "0.18.2",
    "mammoth": "1.12.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "vditor": "3.11.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "astro": "^7.2.1",
    "cheerio": "^1.0.0",
    "cherry-markdown": "0.11.3",
    "gray-matter": "^4.0.3",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.34.5",
    "turndown": "^7.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "hexo": {
    "version": "6.3.0"
  }
}
