{
  "$schema": "./schemas/v1/site-config.schema.json",
  "schemaVersion": 1,
  "roots": {
    "content": "content",
    "assets": "assets",
    "schemas": "schemas",
    "external": "external",
    "generated": "generated"
  },
  "allowedExternalHosts": [
    "blog.csdn.net",
    "cdn.jsdelivr.net",
    "d.apkpure.com",
    "d33wubrfki0l68.cloudfront.net",
    "dldir1.qq.com",
    "fomal.cc",
    "github.com",
    "go.microsoft.com",
    "hexo.io",
    "ikuuu.eu",
    "im.qq.com",
    "mhexo.github.io",
    "npm.elemecdn.com",
    "pc.weixin.qq.com",
    "player.bilibili.com",
    "shinki0325.github.io",
    "www.bilibili.com",
    "www.fomal.cc",
    "www.microsoft.com",
    "www.youtube.com",
    "youtu.be"
  ],
  "assetPolicy": {
    "metadataFile": "metadata.json",
    "publicPath": "/media",
    "allowedExtensions": [
      ".avif",
      ".gif",
      ".ico",
      ".jpeg",
      ".jpg",
      ".mp3",
      ".pdf",
      ".png",
      ".svg",
      ".webp"
    ],
    "maxBytes": 10485760,
    "requireAlt": true,
    "requireRights": true
  },
  "siteDataPolicy": {
    "releaseRetention": 5,
    "immutableCacheControl": "public, max-age=31536000, immutable",
    "mutableCacheControl": "public, max-age=0, must-revalidate",
    "hybridIndex": {
      "maxShardBytes": 131072,
      "objectHashPrefixLength": 2
    }
  }
}
