---
const { title, description, active = '' } = Astro.props
const navItems = [
  { id: 'tools', label: '工具', href: '/tools/' },
  { id: 'knowledge', label: '知识库', href: '/knowledge/' },
  { id: 'pulse', label: '热点', href: '/pulse/' }
]
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href="/css/experience.css" />
  </head>
  <body>
    <header class="experience-topbar">
      <a class="experience-brand" href="/" aria-label="返回 DAT 博客">DAT<span>.</span></a>
      <nav aria-label="体验入口">
        {navItems.map((item) => (
          <a class:list={[{ active: active === item.id }]} href={item.href}>{item.label}</a>
        ))}
      </nav>
      <button class="experience-theme" id="experience-theme" type="button" aria-label="切换深色模式" aria-pressed="false">◐</button>
    </header>

    <main class="experience-main">
      <slot />
    </main>

    <footer class="experience-footer">
      <a href="/">DAT 博客</a><span>·</span><span>本地优先，轻量阅读</span>
    </footer>

    <script is:inline>
      const root = document.documentElement
      const themeButton = document.querySelector('#experience-theme')
      const themeColors = {
        red: 'rgb(241, 71, 71)', orange: 'rgb(241, 162, 71)', yellow: 'rgb(241, 238, 71)',
        purple: 'rgb(179, 71, 241)', blue: 'rgb(102, 204, 255)', gray: 'rgb(226, 226, 226)',
        green: 'rgb(57, 197, 187)', whitegray: 'rgb(241, 241, 241)', pink: 'rgb(237, 112, 155)',
        black: 'rgb(0, 0, 0)', darkblue: 'rgb(97, 100, 159)', heoblue: 'rgb(66, 90, 239)'
      }
      const configuredColor = themeColors[localStorage.getItem('themeColor')]
      if (configuredColor) root.style.setProperty('--theme-color', configuredColor)
      const configuredFont = localStorage.getItem('font')
      if (configuredFont === 'default') root.style.setProperty('--global-font', '-apple-system')
      else if (configuredFont) root.style.setProperty('--global-font', configuredFont)
      const configuredBackground = localStorage.getItem('blogbg') || localStorage.getItem('web_bg')
      if (configuredBackground?.startsWith('#')) {
        root.style.setProperty('--experience-bg', configuredBackground)
        root.style.setProperty('--experience-bg-image', 'none')
      } else if (configuredBackground?.startsWith('url(')) {
        root.style.setProperty('--experience-bg-image', configuredBackground)
      }
      const readTheme = () => {
        try {
          const stored = JSON.parse(localStorage.getItem('theme') || 'null')
          return stored?.value || stored || localStorage.getItem('dat-experience-theme')
        } catch {
          return localStorage.getItem('dat-experience-theme')
        }
      }
      const storedTheme = readTheme()
      if (storedTheme === 'dark' || storedTheme === 'light') root.dataset.theme = storedTheme
      const updateThemeButton = () => {
        const dark = root.dataset.theme === 'dark'
        themeButton?.setAttribute('aria-pressed', String(dark))
        themeButton?.setAttribute('aria-label', dark ? '切换浅色模式' : '切换深色模式')
        if (themeButton) themeButton.textContent = dark ? '☼' : '☾'
      }
      updateThemeButton()
      themeButton?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark'
        localStorage.setItem('theme', JSON.stringify({ value: root.dataset.theme, expiry: Date.now() + 2 * 86400000 }))
        localStorage.setItem('dat-experience-theme', root.dataset.theme)
        updateThemeButton()
      })
    </script>
  </body>
</html>
