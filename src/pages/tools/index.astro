---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

import ExperiencePage from '../../components/ExperiencePage.astro'

const root = path.resolve('generated', 'site-data')
const toolManifests = JSON.parse(await readFile(path.join(root, 'tool-manifests.json'), 'utf8'))
const tools = toolManifests.tools.map((tool) => ({
  ...tool,
  description: tool.id === 'tool.local-json' ? '格式化、校验并下载 JSON' : '在本地计算 SHA-256 摘要',
  icon: tool.id === 'tool.local-json' ? '⌘' : '#',
  keywords: tool.id === 'tool.local-json' ? 'json 格式化 prettify 校验' : 'sha256 hash 哈希 摘要'
}))
---

<ExperiencePage title="DAT · 工具" description="DAT 的个性化本地工具首页" active="tools">
  <section class="tool-home" aria-labelledby="tool-home-title">
    <div class="tool-home-intro">
      <p class="experience-eyebrow">DAT / 工具台</p>
      <h1 id="tool-home-title">今天想做什么？</h1>
      <p class="tool-home-lede">输入关键词，或者直接挑一个工具。文件和文本默认只留在你的浏览器里。</p>
      <form class="tool-search" id="tool-search-form" role="search">
        <span aria-hidden="true">⌕</span>
        <input id="tool-search" type="search" autocomplete="off" placeholder="搜索工具" aria-label="搜索工具" />
        <kbd>/</kbd>
      </form>
      <div class="tool-quick-links" aria-label="其他入口">
        <a href="/knowledge/">知识库</a>
        <a href="/pulse/">热点</a>
        <a href="/">回到博客</a>
      </div>
    </div>

    <section class="tool-list-section" aria-labelledby="tool-list-title">
      <div class="tool-list-header">
        <h2 id="tool-list-title">工具</h2>
        <span id="tool-list-count">{tools.length} 个</span>
      </div>
      <ul class="tool-list" id="tool-list">
        {tools.map((tool) => (
          <li class="tool-item" data-search={`${tool.title} ${tool.description} ${tool.keywords}`}>
            <div class="tool-item-icon" aria-hidden="true">{tool.icon}</div>
            <div class="tool-item-main">
              <h3 class="tool-item-title"><a class="tool-open" href={tool.route} data-tool-id={tool.id}>{tool.title}</a></h3>
              <p class="tool-item-desc">{tool.description}</p>
              <div class="tool-item-meta"><span>仅本地</span><span>{tool.offline.supported ? '离线可用' : '需要网络'}</span></div>
            </div>
            <button class="tool-favorite" type="button" data-favorite={tool.id} aria-label={`收藏${tool.title}`} aria-pressed="false">☆</button>
            <a class="tool-item-open" href={tool.route} data-tool-id={tool.id} aria-label={`打开${tool.title}`}>→</a>
          </li>
        ))}
      </ul>
      <p class="tool-empty" id="tool-empty" hidden>没有匹配的工具。</p>
      <p class="tool-noscript"><noscript>JavaScript 已禁用；工具列表仍可直接打开，文件不会上传。</noscript></p>
    </section>
  </section>

  <script is:inline type="module">
    const search = document.querySelector('#tool-search')
    const list = document.querySelector('#tool-list')
    const count = document.querySelector('#tool-list-count')
    const empty = document.querySelector('#tool-empty')
    const items = [...document.querySelectorAll('.tool-item')]
    const favoritesKey = 'dat-tool-favorites'
    const recentKey = 'dat-tool-recent'
    const readSet = (key) => { try { return new Set(JSON.parse(localStorage.getItem(key) || '[]')) } catch { return new Set() } }
    const writeSet = (key, set) => localStorage.setItem(key, JSON.stringify([...set]))
    const favorites = readSet(favoritesKey)
    const updateFavoriteButtons = () => document.querySelectorAll('[data-favorite]').forEach((button) => {
      const active = favorites.has(button.dataset.favorite)
      button.setAttribute('aria-pressed', String(active))
      button.textContent = active ? '★' : '☆'
    })
    const sortItems = () => {
      const recent = readSet(recentKey)
      const rank = (item) => (favorites.has(item.querySelector('[data-favorite]')?.dataset.favorite) ? 2 : recent.has(item.querySelector('[data-favorite]')?.dataset.favorite) ? 1 : 0)
      items.sort((left, right) => rank(right) - rank(left)).forEach((item) => list.append(item))
    }
    const filter = () => {
      const query = search.value.trim().toLowerCase()
      let visible = 0
      items.forEach((item) => {
        const matches = !query || item.dataset.search.toLowerCase().includes(query)
        item.hidden = !matches
        if (matches) visible += 1
      })
      count.textContent = `${visible} 个`
      empty.hidden = visible !== 0
    }
    search.addEventListener('input', filter)
    document.querySelector('#tool-search-form').addEventListener('submit', (event) => event.preventDefault())
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== search && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) { event.preventDefault(); search.focus() }
      if (event.key === 'Escape' && document.activeElement === search) { search.value = ''; filter(); search.blur() }
    })
    document.querySelectorAll('[data-favorite]').forEach((button) => button.addEventListener('click', () => {
      const id = button.dataset.favorite
      if (favorites.has(id)) favorites.delete(id); else favorites.add(id)
      writeSet(favoritesKey, favorites); updateFavoriteButtons(); sortItems()
    }))
    document.querySelectorAll('[data-tool-id]').forEach((link) => link.addEventListener('click', () => {
      const recent = readSet(recentKey); recent.delete(link.dataset.toolId); recent.add(link.dataset.toolId); writeSet(recentKey, recent)
    }))
    updateFavoriteButtons(); sortItems(); filter()
  </script>
</ExperiencePage>
