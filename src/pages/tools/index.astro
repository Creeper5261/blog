---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

import NativePageFrame from '../../components/NativePageFrame.astro'
import { buildToolManifestPayload } from '../../../tools/capabilities/manifests.mjs'

const root = path.resolve('generated', 'site-data')
let toolManifests
try {
  toolManifests = JSON.parse(await readFile(path.join(root, 'tool-manifests.json'), 'utf8'))
} catch (error) {
  if (error.code !== 'ENOENT') throw error
  toolManifests = buildToolManifestPayload()
}
const toolPresentation = {
  'tool.codec': { description: 'JSON、摘要与文本编码转换', icon: '⌘', keywords: 'json sha256 hash base64 url unicode mdx 编码' },
  'tool.markdown-editor': { description: 'Markdown / MDX 分屏编辑与数学预览', icon: '✎', keywords: 'markdown mdx latex katex math 编辑器' },
  'tool.image-compressor': { description: '本地压缩图片并转换格式', icon: '▧', keywords: 'image jpeg png webp 压缩转换 squoosh compressor' },
  'tool.document-converter': { description: 'PDF、Word 与图片批量转换和拼接', icon: '⇄', keywords: 'pdf word docx image png jpeg 文档 转换 合并 批量' },
  'tool.latex-instant': { description: 'LaTeX 源码即时增量预览', icon: '∑', keywords: 'latex tex katex equation paper 即时 论文 数学' }
}
const tools = toolManifests.tools.map((tool) => ({ ...tool, ...toolPresentation[tool.id] }))
---

<NativePageFrame title="工具 · DAT" pageName="工具" description="DAT 工具" route="/tools/" comments={false} fastInteractive={true}>
  <section class="tool-home" aria-label="工具与搜索">
    <div class="tool-home-intro">
      <form class="tool-search" action="https://www.google.com/search" method="get" target="_blank" role="search">
        <span class="tool-search-mark" aria-hidden="true">⌕</span>
        <input id="tool-search" name="q" type="search" autocomplete="off" placeholder="搜索 Google" aria-label="Google 搜索" />
        <button type="submit">搜索</button>
      </form>
    </div>

    <section class="tool-list-section" aria-label="工具列表">
      <ul class="tool-list" id="tool-list">
        {tools.map((tool) => (
          <li class="tool-item" data-search={`${tool.title} ${tool.description} ${tool.keywords}`}>
            <a class="tool-item-link" href={tool.route} data-tool-id={tool.id}>
              <span class="tool-item-icon" aria-hidden="true">{tool.icon}</span>
              <span class="tool-item-main">
                <span class="tool-item-title">{tool.title}</span>
                <span class="tool-item-desc">{tool.description}</span>
                <span class="tool-item-meta">{tool.offline.supported ? '离线可用' : '需要网络'}</span>
              </span>
              <span class="tool-item-open" aria-hidden="true">↗</span>
            </a>
            <button class="tool-favorite" type="button" data-favorite={tool.id} aria-label={`收藏${tool.title}`} aria-pressed="false">☆</button>
          </li>
        ))}
      </ul>
      <p class="tool-empty" id="tool-empty" hidden>没有可用工具。</p>
      <p class="tool-noscript"><noscript>JavaScript 已禁用；工具仍可直接打开，文件不会上传。</noscript></p>
    </section>
  </section>

  <script is:inline type="module">
    const list = document.querySelector('#tool-list')
    const items = [...document.querySelectorAll('.tool-item')]
    const favoritesKey = 'dat-tool-favorites'
    const recentKey = 'dat-tool-recent'
    const readSet = (key) => { try { return new Set(JSON.parse(localStorage.getItem(key) || '[]')) } catch { return new Set() } }
    const writeSet = (key, set) => localStorage.setItem(key, JSON.stringify([...set]))
    const favorites = readSet(favoritesKey)
    const updateFavoriteButtons = () => document.querySelectorAll('[data-favorite]').forEach((button) => {
      const active = favorites.has(button.dataset.favorite)
      button.setAttribute('aria-pressed', String(active))
      button.textContent = active ? '★' : '☆'
    })
    const sortItems = () => {
      const recent = readSet(recentKey)
      const rank = (item) => (favorites.has(item.querySelector('[data-favorite]')?.dataset.favorite) ? 2 : recent.has(item.querySelector('[data-favorite]')?.dataset.favorite) ? 1 : 0)
      items.sort((left, right) => rank(right) - rank(left)).forEach((item) => list.append(item))
    }
    document.querySelectorAll('[data-favorite]').forEach((button) => button.addEventListener('click', () => {
      const id = button.dataset.favorite
      if (favorites.has(id)) favorites.delete(id); else favorites.add(id)
      writeSet(favoritesKey, favorites); updateFavoriteButtons(); sortItems()
    }))
    document.querySelectorAll('[data-tool-id]').forEach((link) => link.addEventListener('click', () => {
      const recent = readSet(recentKey); recent.delete(link.dataset.toolId); recent.add(link.dataset.toolId); writeSet(recentKey, recent)
    }))
    updateFavoriteButtons(); sortItems()
  </script>
</NativePageFrame>
