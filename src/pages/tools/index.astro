---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

const root = path.resolve('generated', 'site-data')
const release = JSON.parse(await readFile(path.join(root, 'release.json'), 'utf8'))
const toolManifests = JSON.parse(await readFile(path.join(root, 'tool-manifests.json'), 'utf8'))
const routesPayload = JSON.parse(await readFile(path.join(root, 'routes.json'), 'utf8'))
const releasePath = release.cache.immutableReleasePath
const tools = toolManifests.tools
const siteRoutes = routesPayload.items.filter((item) => item.source === 'site-routes')
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="由工具 manifest 驱动的本地优先工具目录" />
    <title>工具目录</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { max-width: 72rem; margin: 0 auto; padding: 2rem 1rem 4rem; line-height: 1.55; }
      h1 { margin-bottom: .25rem; }
      .lede, .muted { color: color-mix(in srgb, currentColor 72%, transparent); }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: .9rem; padding: 0; list-style: none; }
      .card { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: .7rem; padding: 1rem; }
      .card h2 { margin: .15rem 0 .35rem; font-size: 1.1rem; }
      .card a { color: inherit; }
      .chips { display: flex; flex-wrap: wrap; gap: .35rem; padding: 0; list-style: none; }
      .chip { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: 999px; padding: .16rem .5rem; font-size: .82rem; }
      .routes { columns: 2 16rem; column-gap: 2rem; padding: 0; list-style: none; }
      .status { min-height: 1.5rem; }
      .error { color: #c62828; }
      @media (max-width: 48rem) { .cards { grid-template-columns: 1fr; } .routes { columns: 1; } }
    </style>
  </head>
  <body data-tools-url={`${releasePath}tool-manifests.json`}>
    <main>
      <p><a href="/">返回首页</a> · <a href="/topics/">主题展厅</a> · <a href="/lab/">本地实验台</a> · <a href="/knowledge-data/">查看 site-data</a></p>
      <h1>工具目录</h1>
      <p class="lede">每个工具都由 manifest 声明输入、输出、隐私与离线能力；默认在浏览器本地处理，不上传文件。</p>

      {tools.length > 0 ? (
        <ul class="cards" id="tool-cards">
          {tools.map((tool) => (
            <li class="card">
              <h2><a href={tool.route}>{tool.title}</a></h2>
              <p class="muted">输入 {tool.input.kinds.join('、')} · 输出 {tool.output.kinds.join('、')}</p>
              <ul class="chips">
                <li class="chip">隐私：{tool.privacy.mode === 'local-only' ? '仅本地' : tool.privacy.mode}</li>
                <li class="chip">{tool.offline.supported ? '支持离线' : '需要网络'}</li>
                <li class="chip">{tool.runtime.worker ? 'Worker 执行' : '主线程执行'}</li>
              </ul>
            </li>
          ))}
        </ul>
      ) : (
        <section><h2>暂无工具</h2><p>工具 manifest 尚未发布；此页仍保留导航与静态说明。</p></section>
      )}

      <h2>站点导航</h2>
      <ul class="routes">
        {siteRoutes.map((route) => (
          <li><a href={route.route}>{route.title}</a> <span class="muted">{route.route}</span></li>
        ))}
      </ul>

      <p id="status" class="status" role="status">以上内容来自当前版本化发布包。</p>
      <noscript><p class="muted">JavaScript 已禁用；上方工具列表仍可阅读。页面不会上传或请求在线处理服务。</p></noscript>
    </main>
    <script is:inline type="module">
      const status = document.querySelector('#status')
      const cards = document.querySelector('#tool-cards')
      const url = document.body.dataset.toolsUrl
      const renderTool = (tool) => {
        const item = document.createElement('li'); item.className = 'card'
        const heading = document.createElement('h2')
        const link = document.createElement('a'); link.href = tool.route; link.textContent = tool.title
        heading.append(link)
        const meta = document.createElement('p'); meta.className = 'muted'; meta.textContent = `输入 ${tool.input.kinds.join('、')} · 输出 ${tool.output.kinds.join('、')}`
        const chips = document.createElement('ul'); chips.className = 'chips'
        for (const label of [`隐私：${tool.privacy.mode === 'local-only' ? '仅本地' : tool.privacy.mode}`, tool.offline.supported ? '支持离线' : '需要网络', tool.runtime.worker ? 'Worker 执行' : '主线程执行']) {
          const chip = document.createElement('li'); chip.className = 'chip'; chip.textContent = label
          chips.append(chip)
        }
        item.append(heading, meta, chips)
        return item
      }
      if (url && cards) {
        try {
          const response = await fetch(url, { cache: 'force-cache' })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const payload = await response.json()
          const fresh = payload.tools
          if (Array.isArray(fresh) && fresh.length) {
            cards.replaceChildren(...fresh.map(renderTool))
            status.textContent = `已从版本化 JSON 更新 ${fresh.length} 个工具；未上传任何文件。`
          }
        } catch (error) {
          status.classList.add('error')
          status.textContent = `版本化工具数据请求失败，保留预渲染内容：${error.message}`
        }
      }
    </script>
  </body>
</html>
