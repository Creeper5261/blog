---
import NativePageFrame from '../../../components/NativePageFrame.astro'

const sample = `# DAT Markdown

左侧输入 Markdown，右侧即时预览。

行内公式：$E=mc^2$

$$
\\int_0^1 x^2\,dx = \\frac{1}{3}
$$

支持 **加粗**、列表、表格、代码块和任务清单。`
---

<NativePageFrame title="Markdown 编辑器 · DAT" pageName="Markdown 编辑器" description="Markdown / MDX 分屏编辑器" route="/tools/markdown/" comments={false} layoutClass="tool-workspace-layout">
  <section class="markdown-editor-page" aria-label="Markdown 编辑器" data-format="markdown">
    <header class="workspace-heading">
      <h1>Markdown 编辑器</h1>
    </header>
    <div class="markdown-editor-actions">
      <button id="markdown-open" type="button">打开 .md / .mdx</button>
      <button id="markdown-copy" type="button">复制 Markdown</button>
      <button id="markdown-download" type="button">下载</button>
      <button id="markdown-clear" type="button">清空</button>
      <span id="markdown-status" role="status">本地编辑；内容不会上传。</span>
    </div>
    <input id="markdown-file" type="file" accept="text/markdown,.md,.mdx" hidden />
    <div class="markdown-workbench" data-ready="false">
      <section class="markdown-source-pane" aria-label="Markdown 源码">
        <label class="markdown-pane-label" for="markdown-input">Markdown</label>
        <textarea id="markdown-input" spellcheck="false">{sample}</textarea>
      </section>
      <section class="markdown-preview-pane" aria-label="Markdown 预览" aria-busy="true">
        <div id="markdown-preview-loading" class="markdown-preview-loading" role="status">正在加载预览…</div>
        <div id="markdown-preview" tabindex="0"></div>
      </section>
    </div>
    <p class="reading-noscript"><noscript>无 JavaScript 时可复制下方 Markdown 示例到本地编辑器：<br /><code>{sample}</code></noscript></p>
  </section>
  <link rel="stylesheet" href="/vendor/vditor/dist/index.css" />
  <script is:inline src="/vendor/vditor/dist/index.min.js"></script>
  <script src="../../../scripts/tools-markdown.js"></script>
</NativePageFrame>
