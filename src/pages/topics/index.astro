---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

const root = path.resolve('generated', 'site-data')
const release = JSON.parse(await readFile(path.join(root, 'release.json'), 'utf8'))
const topicsPayload = JSON.parse(await readFile(path.join(root, 'topics.json'), 'utf8'))
const releasePath = release.cache.immutableReleasePath
const collections = topicsPayload.collections
const memberCount = collections.reduce((total, collection) => total + collection.members.length, 0)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="由版本化 site-data 预渲染的主题集合展厅" />
    <title>主题展厅</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { max-width: 72rem; margin: 0 auto; padding: 2rem 1rem 4rem; line-height: 1.55; }
      h1 { margin-bottom: .25rem; }
      .lede, .muted { color: color-mix(in srgb, currentColor 72%, transparent); }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: .9rem; padding: 0; list-style: none; }
      .card { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: .7rem; padding: 1rem; }
      .card h2 { margin: .15rem 0 .35rem; font-size: 1.15rem; }
      .kind { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; opacity: .72; }
      .members { padding-left: 1.1rem; margin: .5rem 0; }
      .members a { color: inherit; }
      .relations { display: flex; flex-wrap: wrap; gap: .35rem; padding: 0; list-style: none; }
      .relation { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: 999px; padding: .16rem .5rem; font-size: .85rem; }
      .status { min-height: 1.5rem; }
      .error { color: #c62828; }
      @media (max-width: 48rem) { .cards { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body data-topics-url={`${releasePath}topics.json`}>
    <main>
      <p><a href="/">返回首页</a> · <a href="/explore/">主题探索</a> · <a href="/tools/">工具目录</a> · <a href="/knowledge-data/">查看 site-data</a></p>
      <h1>主题展厅</h1>
      <p class="lede">集合、成员与关系均由 Astro 从版本化 site-data 预渲染；浏览器只读取 <code>topics.json</code>，不接触私有源结构。</p>
      <p class="muted">{collections.length} 个集合 · {memberCount} 个成员</p>

      {collections.length > 0 ? (
        <ul class="cards" id="topic-gallery">
          {collections.map((collection) => (
            <li class="card" id={`topic-${collection.id}`}>
              <span class="kind">{collection.kind}</span>
              <h2>{collection.title}</h2>
              <p class="muted">{collection.members.length} 个成员 · 更新于 {collection.updatedAt}</p>
              <ul class="members">
                {collection.members.map((member) => (
                  <li><a href={`/explore/#topic-${member.id}`}>{member.title}</a> <span class="kind">{member.kind}</span></li>
                ))}
              </ul>
              {collection.relations.length > 0 && (
                <ul class="relations" aria-label="关系">
                  {collection.relations.map((edge) => (
                    <li class="relation" title={`${edge.from} → ${edge.to}`}>{edge.type}</li>
                  ))}
                </ul>
              )}
              <p><a href={`/narratives/${collection.id}/`}>阅读专题叙事</a></p>
            </li>
          ))}
        </ul>
      ) : (
        <section><h2>暂无集合</h2><p>主题数据尚未发布；此页仍保留导航与静态说明。</p></section>
      )}

      <p id="status" class="status" role="status">以上内容来自当前版本化发布包。</p>
      <noscript><p class="muted">JavaScript 已禁用；上方主题列表仍可阅读。页面不会请求在线来源。</p></noscript>
    </main>
    <script is:inline type="module">
      const status = document.querySelector('#status')
      const gallery = document.querySelector('#topic-gallery')
      const url = document.body.dataset.topicsUrl
      const renderCollection = (collection) => {
        const item = document.createElement('li'); item.className = 'card'; item.id = `topic-${collection.id}`
        const kind = document.createElement('span'); kind.className = 'kind'; kind.textContent = collection.kind
        const heading = document.createElement('h2'); heading.textContent = collection.title
        const meta = document.createElement('p'); meta.className = 'muted'; meta.textContent = `${collection.members.length} 个成员 · 更新于 ${collection.updatedAt}`
        const members = document.createElement('ul'); members.className = 'members'
        for (const member of collection.members) {
          const entry = document.createElement('li')
          const link = document.createElement('a'); link.href = `/explore/#topic-${member.id}`; link.textContent = member.title
          const memberKind = document.createElement('span'); memberKind.className = 'kind'; memberKind.textContent = member.kind
          entry.append(link, ' ', memberKind); members.append(entry)
        }
        const relations = document.createElement('ul'); relations.className = 'relations'
        for (const edge of collection.relations ?? []) {
          const chip = document.createElement('li'); chip.className = 'relation'; chip.title = `${edge.from} → ${edge.to}`; chip.textContent = edge.type
          relations.append(chip)
        }
        const narrative = document.createElement('p')
        const narrativeLink = document.createElement('a'); narrativeLink.href = `/narratives/${collection.id}/`; narrativeLink.textContent = '阅读专题叙事'
        narrative.append(narrativeLink)
        item.append(kind, heading, meta, members)
        if (relations.children.length) item.append(relations)
        item.append(narrative)
        return item
      }
      if (url && gallery) {
        try {
          const response = await fetch(url, { cache: 'force-cache' })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const payload = await response.json()
          const fresh = payload.collections
          if (Array.isArray(fresh) && fresh.length) {
            gallery.replaceChildren(...fresh.map(renderCollection))
            status.textContent = `已从版本化 JSON 更新 ${fresh.length} 个集合；未访问私有源。`
          }
        } catch (error) {
          status.classList.add('error')
          status.textContent = `版本化主题数据请求失败，保留预渲染内容：${error.message}`
        }
      }
    </script>
  </body>
</html>
