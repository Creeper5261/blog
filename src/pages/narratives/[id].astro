---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

export async function getStaticPaths() {
  const root = path.resolve('generated', 'site-data')
  const [release, topicsPayload, explainPayload] = await Promise.all([
    readFile(path.join(root, 'release.json'), 'utf8').then(JSON.parse),
    readFile(path.join(root, 'topics.json'), 'utf8').then(JSON.parse),
    readFile(path.join(root, 'explain.json'), 'utf8').then(JSON.parse)
  ])
  const releasePath = release.cache.immutableReleasePath
  const explainUnit = explainPayload.units.find((unit) => unit.id === 'explain.queue-enqueue') ?? explainPayload.units[0]
  return topicsPayload.collections.map((collection) => ({
    params: { id: collection.id },
    props: { collection, releasePath, explainUnit }
  }))
}

const { collection, releasePath, explainUnit } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`专题叙事：${collection.title}`} />
    <title>{collection.title} · 专题叙事</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { max-width: 72rem; margin: 0 auto; padding: 2rem 1rem 4rem; line-height: 1.6; }
      h1 { margin: .15rem 0 .3rem; font-size: 1.7rem; }
      .lede, .muted { color: color-mix(in srgb, currentColor 72%, transparent); }
      .steps { padding: 0; list-style: none; counter-reset: narrative; }
      .step { border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: .7rem; padding: 1rem 1rem 1rem 3.2rem; margin: .8rem 0; position: relative; counter-increment: narrative; }
      .step::before { content: counter(narrative); position: absolute; left: 1rem; top: 1rem; font-size: 1.1rem; font-weight: 700; opacity: .55; }
      .step h2 { margin: 0 0 .25rem; font-size: 1.1rem; }
      .step a { color: inherit; }
      .chips { display: flex; flex-wrap: wrap; gap: .35rem; padding: 0; list-style: none; margin: .5rem 0 0; }
      .chip { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: 999px; padding: .16rem .5rem; font-size: .84rem; }
      .explain-unit { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: .8rem; padding: 1rem; margin-top: 1.4rem; }
      .explain-unit .step { border: none; border-left: 3px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 0; padding: .5rem .7rem; margin: .5rem 0; counter-increment: none; }
      .explain-unit .step::before { content: none; }
      .explain-unit .step[data-current="true"] { border-left-color: Highlight; background: color-mix(in srgb, Highlight 12%, transparent); }
      .explain-unit .step[hidden] { display: none; }
      button { border: 1px solid color-mix(in srgb, currentColor 32%, transparent); border-radius: .45rem; background: Canvas; color: CanvasText; padding: .45rem .75rem; cursor: pointer; }
      button + button { margin-left: .4rem; }
      .status { min-height: 1.5rem; }
      .error { color: #c62828; }
      details { margin-top: .8rem; }
      code { overflow-wrap: anywhere; }
      @media (max-width: 48rem) { .step { padding-left: 2.6rem; } .step::before { left: .7rem; } }
    </style>
  </head>
  <body data-explain-url={`${releasePath}explain.json`} data-topics-url={`${releasePath}topics.json`} data-narrative-id={collection.id}>
    <main>
      <p><a href="/">返回首页</a> · <a href="/narratives/">专题叙事目录</a> · <a href="/topics/">主题展厅</a> · <a href="/explore/map/">探索地图</a></p>
      <span class="muted">collection · {collection.members.length} 个成员</span>
      <h1>{collection.title} · 专题叙事</h1>
      <p class="lede">这条叙事由构建期从主题集合与关系图派生：按成员顺序展开，并在每个对象旁标注它与其他对象的关系。</p>
      <p class="muted">更新于 {collection.updatedAt}</p>

      <ol class="steps" aria-label="叙事步骤">
        {collection.members.map((member) => {
          const related = collection.relations.filter((edge) => edge.from === member.id || edge.to === member.id)
          return (
            <li class="step">
              <span class="muted">{member.kind}</span>
              <h2><a href={`/explore/#topic-${member.id}`}>{member.title}</a></h2>
              <p class="muted">更新于 {member.updatedAt}</p>
              {related.length > 0 && (
                <ul class="chips" aria-label="关系">
                  {related.map((edge) => (
                    <li class="chip" title={`${edge.from} → ${edge.to}`}>{edge.type}</li>
                  ))}
                </ul>
              )}
            </li>
          )
        })}
      </ol>

      {explainUnit ? (
        <section aria-labelledby="embedded-explain-title">
          <h2 id="embedded-explain-title">可操作示例：{explainUnit.title}</h2>
          <p id="load-status" class="status" role="status">已预渲染解释单元；等待版本化 JSON 校验。</p>
          <article class="explain-unit" data-unit-id={explainUnit.id}>
            <p>{explainUnit.description}</p>
            <p class="muted"><code>{explainUnit.id}</code> · 模型：{explainUnit.model.kind}</p>
            <ol class="steps" aria-label={explainUnit.accessibility.liveRegion}>
              {explainUnit.steps.map((step, index) => (
                <li class="step" data-step-index={index} data-current={index === 0 ? 'true' : 'false'} hidden={index > 0}>
                  <strong>{step.title}</strong><br />{step.text}
                  {step.annotation ? <small class="muted">说明：{step.annotation}</small> : null}
                </li>
              ))}
            </ol>
            <p class="muted">{explainUnit.accessibility.instructions}</p>
            <p>
              <button type="button" data-action="advance" aria-label={explainUnit.controls.step}>下一步</button>
              <button type="button" data-action="reset" aria-label={explainUnit.controls.reset}>重置</button>
            </p>
            <p class="unit-status" role="status" aria-live="polite">第 1/{explainUnit.steps.length} 步：{explainUnit.steps[0].title}</p>
            <details>
              <summary>静态回退说明</summary>
              <p>{explainUnit.staticFallback.summary}</p>
              <ol>{explainUnit.staticFallback.steps.map((step) => <li>{step}</li>)}</ol>
            </details>
          </article>
        </section>
      ) : null}

      <p id="status" class="status" role="status">叙事与解释单元来自当前版本化发布包。</p>
      <noscript><p class="muted">JavaScript 已禁用；叙事步骤、关系标注与解释单元的静态回退仍完整可读。</p></noscript>
    </main>
    <script type="module" src="/js/explain-runtime.js"></script>
    <script is:inline type="module">
      const status = document.querySelector('#status')
      const url = document.body.dataset.topicsUrl
      if (url && status) {
        try {
          const response = await fetch(url, { cache: 'force-cache' })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const payload = await response.json()
          const collection = payload.collections?.find((entry) => entry.id === document.body.dataset.narrativeId)
          status.textContent = collection
            ? `已确认版本化主题数据（${collection.members.length} 个成员）；叙事为预渲染 HTML。`
            : `版本化主题数据未包含当前专题，保留预渲染内容。`
        } catch (error) {
          status.classList.add('error')
          status.textContent = `版本化主题数据请求失败，保留预渲染内容：${error.message}`
        }
      }
    </script>
  </body>
</html>
