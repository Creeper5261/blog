---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

const root = path.resolve('generated', 'site-data')
const release = JSON.parse(await readFile(path.join(root, 'release.json'), 'utf8'))
const topicsPayload = JSON.parse(await readFile(path.join(root, 'topics.json'), 'utf8'))
const releasePath = release.cache.immutableReleasePath
const collections = topicsPayload.collections
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="按专题顺序讲述对象与关系的叙事目录" />
    <title>专题叙事</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { max-width: 70rem; margin: 0 auto; padding: 2rem 1rem 4rem; line-height: 1.55; }
      h1 { margin-bottom: .25rem; }
      .lede, .muted { color: color-mix(in srgb, currentColor 72%, transparent); }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: .9rem; padding: 0; list-style: none; }
      .card { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: .7rem; padding: 1rem; }
      .card h2 { margin: .15rem 0 .35rem; font-size: 1.15rem; }
      .card a { color: inherit; }
      .status { min-height: 1.5rem; }
      .error { color: #c62828; }
      @media (max-width: 48rem) { .cards { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body data-topics-url={`${releasePath}topics.json`}>
    <main>
      <p><a href="/">返回首页</a> · <a href="/topics/">主题展厅</a> · <a href="/explore/map/">探索地图</a></p>
      <h1>专题叙事</h1>
      <p class="lede">每个集合都是一篇按顺序讲述的专题：从集合进入，逐个成员展开，并标注对象间的关系。</p>
      <p class="muted">{collections.length} 个专题</p>

      {collections.length > 0 ? (
        <ul class="cards" id="narrative-list">
          {collections.map((collection) => (
            <li class="card">
              <span class="muted">{collection.kind} · {collection.members.length} 个成员</span>
              <h2><a href={`/narratives/${collection.id}/`}>{collection.title}</a></h2>
              <p class="muted">{collection.relations.length} 条关系</p>
            </li>
          ))}
        </ul>
      ) : (
        <section><h2>暂无专题</h2><p>主题数据尚未发布；此页仍保留导航与静态说明。</p></section>
      )}

      <p id="status" class="status" role="status">以上目录来自当前版本化发布包。</p>
      <noscript><p class="muted">JavaScript 已禁用；上方专题列表仍可阅读。</p></noscript>
    </main>
    <script is:inline type="module">
      const status = document.querySelector('#status')
      const list = document.querySelector('#narrative-list')
      const url = document.body.dataset.topicsUrl
      if (url && list) {
        try {
          const response = await fetch(url, { cache: 'force-cache' })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const payload = await response.json()
          const fresh = payload.collections
          if (Array.isArray(fresh) && fresh.length) {
            status.textContent = `已从版本化 JSON 确认 ${fresh.length} 个专题；目录为预渲染 HTML。`
          }
        } catch (error) {
          status.classList.add('error')
          status.textContent = `版本化主题数据请求失败，保留预渲染目录：${error.message}`
        }
      }
    </script>
  </body>
</html>
