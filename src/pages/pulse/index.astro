---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

import ExperiencePage from '../../components/ExperiencePage.astro'

const root = path.resolve('generated', 'site-data')
const release = JSON.parse(await readFile(path.join(root, 'release.json'), 'utf8'))
const pulsesPayload = JSON.parse(await readFile(path.join(root, 'pulses.json'), 'utf8'))
const pulse = pulsesPayload.pulses[0]
const releasePath = release.cache.immutableReleasePath
---

<ExperiencePage title="DAT · 热点" description="DAT 的热点阅读页" active="pulse">
  <section class="reading-page" data-pulse-url={`${releasePath}pulses.json`} aria-labelledby="pulse-title">
    <header class="reading-heading">
      <p class="experience-eyebrow">DAT / 热点</p>
      <h1 id="pulse-title">值得现在打开的东西</h1>
      <p>热点由构建侧整理成可追溯快照，页面只负责阅读，不在浏览器里连接在线来源。</p>
    </header>

    {pulse ? (
      <>
        <div class="reading-meta"><span>来自 {pulse.source}</span><span>更新于 {pulse.fetchedAt}</span><span>{pulse.items.length} 条</span></div>
        <ul class="reading-list pulse-list" id="pulse-items">
          {pulse.items.map((item) => (
            <li class="reading-row">
              <div class="reading-row-main">
                <span class="reading-row-label">{pulse.source}</span>
                <h2><a href={item.url} target="_blank" rel="noreferrer">{item.title}</a></h2>
                <p>{item.summary || '打开看看。'}</p>
              </div>
              <span class="pulse-score">{item.score !== undefined ? item.score : ''}</span>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="reading-status">暂时没有热点。</p>
    )}

    <p class="reading-status" id="pulse-status" role="status">以上内容来自最近一次有效快照。</p>
    <p class="reading-noscript"><noscript>JavaScript 已禁用；热点列表仍可阅读。</noscript></p>
  </section>

  <script is:inline>
    const page = document.querySelector('.reading-page')
    const list = document.querySelector('#pulse-items')
    const status = document.querySelector('#pulse-status')
    const url = page?.dataset.pulseUrl
    if (url && list) {
      try {
        const response = await fetch(url, { cache: 'force-cache' })
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        const fresh = (await response.json()).pulses?.[0]
        if (fresh?.items?.length) {
          list.replaceChildren(...fresh.items.map((item) => {
            const row = document.createElement('li'); row.className = 'reading-row'
            const main = document.createElement('div'); main.className = 'reading-row-main'
            const label = document.createElement('span'); label.className = 'reading-row-label'; label.textContent = fresh.source
            const heading = document.createElement('h2'); const link = document.createElement('a'); link.href = item.url; link.target = '_blank'; link.rel = 'noreferrer'; link.textContent = item.title; heading.append(link)
            const summary = document.createElement('p'); summary.textContent = item.summary || '打开看看。'
            const score = document.createElement('span'); score.className = 'pulse-score'; score.textContent = item.score === undefined ? '' : item.score
            main.append(label, heading, summary); row.append(main, score); return row
          }))
          if (status) status.textContent = `已更新 ${fresh.items.length} 条热点。`
        }
      } catch (error) {
        if (status) status.textContent = `更新失败，保留最近快照：${error.message}`
      }
    }
  </script>
</ExperiencePage>
