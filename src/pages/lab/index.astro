---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

import NativePageFrame from '../../components/NativePageFrame.astro'

const manifest = JSON.parse(await readFile(path.resolve('.astro-static', 'runtime', 'manifest.json'), 'utf8'))
const runtimeModuleUrl = manifest.entries.find((entry) => entry.file.endsWith('/local-runtime.js'))?.url
const workerModuleUrl = manifest.entries.find((entry) => entry.file.endsWith('/local-runtime-worker.js'))?.url
const serviceWorkerUrl = manifest.entries.find((entry) => entry.file.includes('local-runtime-sw.'))?.url
if (!runtimeModuleUrl || !workerModuleUrl || !serviceWorkerUrl) throw new Error('S3 runtime manifest is incomplete')
---

<NativePageFrame title="本地实验台 · DAT" pageName="本地实验台" description="S3 本地优先运行时能力演示" route="/lab/">
    <main
      id="runtime-lab"
      class="runtime-lab"
      data-runtime-module={runtimeModuleUrl}
      data-worker-module={workerModuleUrl}
      data-service-worker={serviceWorkerUrl}
    >
      <h1>本地实验台</h1>
      <p class="lede">S3 最小能力原型：文件始终留在浏览器本地，正文和静态说明不依赖 JavaScript。</p>
      <p id="runtime-status" class="status" role="status">正在检测本地能力…</p>

      <section class="card" aria-labelledby="capability-title">
        <h2 id="capability-title">运行时能力</h2>
        <ul id="capabilities" class="capabilities"><li>检测中…</li></ul>
        <button id="clear-local" type="button">清除本站本地数据</button>
      </section>

      <div class="grid">
        <section class="card" aria-labelledby="file-title">
          <h2 id="file-title">本地 JSON 格式化</h2>
          <p class="muted">在 Worker 中处理，最大输入 2 MB；Worker 不可用时可降级到主线程。</p>
          <div id="dropzone" class="dropzone" tabindex="0">拖入 JSON 文件，或点击选择<input id="file-input" type="file" accept="application/json,.json,text/json" hidden /></div>
          <label for="json-input">也可以直接粘贴</label>
          <textarea id="json-input" spellcheck="false">&#123;"items":["A","B"],"ready":true&#125;</textarea>
          <p><button id="format-json" type="button">格式化</button><button id="fallback-json" type="button" hidden>改用主线程</button><button id="reset-json" type="button" hidden>清空并重选小文件</button><button id="download-json" type="button" disabled>下载结果</button><button id="cancel-json" type="button" disabled>取消</button></p>
          <progress id="json-progress" value="0" max="1" hidden></progress>
          <p id="json-status" class="status" role="status"></p>
          <label for="json-output">输出</label>
          <textarea id="json-output" readonly aria-live="polite"></textarea>
        </section>

        <section class="card" aria-labelledby="state-title">
          <h2 id="state-title">可回放状态单元</h2>
          <p class="muted">状态保存在 IndexedDB（不支持时退回内存），每次操作复用同一任务壳。</p>
          <div id="queue" class="queue" aria-live="polite">加载状态…</div>
          <p><button id="enqueue" type="button">入队</button><button id="dequeue" type="button">出队</button><button id="reset-state" type="button">重置</button><button id="export-state" type="button">导出状态</button><button id="fallback-state" type="button" hidden>主线程重试</button></p>
          <progress id="state-progress" value="0" max="1" hidden></progress>
          <p id="state-status" class="status" role="status"></p>
        </section>
      </div>

      <noscript><p>JavaScript 已禁用。两个交互单元不可用，但本页的隐私说明和静态内容仍可阅读。</p></noscript>
    </main>
    <script is:inline type="module">
      const root = document.querySelector('#runtime-lab')
      const runtime = await import(root.dataset.runtimeModule)
      const { createLocalStore, createTaskRunner, detectCapabilities, registerRuntimeServiceWorker } = runtime

      const $ = (selector) => document.querySelector(selector)
      const store = createLocalStore('s3-lab')
      const runner = createTaskRunner({ workerUrl: root.dataset.workerModule })
      const capabilities = detectCapabilities()
      const capabilityNames = { worker: 'Worker', dragDrop: '拖放', indexedDB: 'IndexedDB', opfs: 'OPFS', serviceWorker: '离线缓存', wasm: 'WASM', fileSystemAccess: '文件选择器' }
      const capabilityList = $('#capabilities')
      capabilityList.replaceChildren(...Object.entries(capabilityNames).map(([key, label]) => {
        const item = document.createElement('li')
        item.className = capabilities[key] ? 'ok' : 'no'
        item.textContent = `${label}: ${capabilities[key] ? '可用' : '不可用'}`
        return item
      }))
      const sw = await registerRuntimeServiceWorker(root.dataset.serviceWorker)
      $('#runtime-status').textContent = `运行时已就绪（存储：${store.mode}；离线缓存：${sw.registered ? '已注册' : '不可用或待构建'}）`

      const setStatus = (target, text, error = false) => { target.textContent = text; target.classList.toggle('error', error) }
      const downloadText = (filename, text, type) => {
        const url = URL.createObjectURL(new Blob([text], { type }))
        const link = document.createElement('a')
        link.href = url
        link.download = filename
        link.click()
        setTimeout(() => URL.revokeObjectURL(url), 0)
      }
      const jsonInput = $('#json-input')
      const jsonStatus = $('#json-status')
      const jsonProgress = $('#json-progress')
      let jsonController
      const formatJson = async (forceMainThread = false) => {
        jsonController?.abort()
        jsonController = new AbortController()
        jsonProgress.hidden = false
        $('#cancel-json').disabled = false
        $('#fallback-json').hidden = true
        $('#reset-json').hidden = true
        try {
          const result = await runner.run('format-json', { input: jsonInput.value }, {
            signal: jsonController.signal,
            forceMainThread,
            onProgress: (value, label) => { jsonProgress.value = value; setStatus(jsonStatus, label) }
          })
          $('#json-output').value = result.output
          $('#download-json').disabled = false
          setStatus(jsonStatus, `完成：${result.bytes} bytes`)
        } catch (error) {
          const cancelled = error.name === 'AbortError'
          const tooLarge = error.code === 'TASK_INPUT_TOO_LARGE'
          const message = cancelled
            ? '已取消，Worker 已停止'
            : tooLarge
              ? `${error.message}；请拆分或选择更小的文件`
              : `处理失败：${error.message}；可改用主线程重试`
          setStatus(jsonStatus, message, !cancelled)
          $('#fallback-json').hidden = cancelled || tooLarge
          $('#reset-json').hidden = !tooLarge
        } finally {
          $('#cancel-json').disabled = true
          jsonProgress.hidden = true
        }
      }
      $('#format-json').addEventListener('click', () => formatJson(false))
      $('#fallback-json').addEventListener('click', () => formatJson(true))
      $('#reset-json').addEventListener('click', () => { jsonInput.value = ''; $('#json-output').value = ''; $('#download-json').disabled = true; $('#reset-json').hidden = true; setStatus(jsonStatus, '已清空，请重新选择小于 2 MB 的文件'); jsonInput.focus() })
      $('#download-json').addEventListener('click', () => downloadText('formatted.json', $('#json-output').value, 'application/json'))
      $('#cancel-json').addEventListener('click', () => jsonController?.abort())
      const readFile = async (file) => { jsonInput.value = await file.text(); await formatJson() }
      $('#file-input').addEventListener('change', (event) => { const [file] = event.target.files; if (file) readFile(file) })
      $('#dropzone').addEventListener('click', () => $('#file-input').click())
      $('#dropzone').addEventListener('dragover', (event) => { event.preventDefault(); $('#dropzone').dataset.active = 'true' })
      $('#dropzone').addEventListener('dragleave', () => { delete $('#dropzone').dataset.active })
      $('#dropzone').addEventListener('drop', (event) => { event.preventDefault(); delete $('#dropzone').dataset.active; const [file] = event.dataTransfer.files; if (file) readFile(file) })

      let state = await store.get('queue') || { items: [] }
      const renderState = () => { $('#queue').textContent = state.items.length ? state.items.join(' → ') : '队列为空' }
      renderState()
      let lastStateAction
      const stepState = async (action, forceMainThread = false) => {
        lastStateAction = action
        const progress = $('#state-progress')
        progress.hidden = false
        $('#fallback-state').hidden = true
        try {
          state = await runner.run('state-step', { state, action }, { forceMainThread, onProgress: (value, label) => { progress.value = value; setStatus($('#state-status'), label) } })
          await store.set('queue', state)
          renderState()
          setStatus($('#state-status'), `已${action === 'enqueue' ? '入队' : '出队'}，状态已保存`)
        } catch (error) { setStatus($('#state-status'), `状态处理失败：${error.message}；可主线程重试`, true); $('#fallback-state').hidden = false } finally { progress.hidden = true }
      }
      $('#enqueue').addEventListener('click', () => stepState('enqueue'))
      $('#dequeue').addEventListener('click', () => stepState('dequeue'))
      $('#fallback-state').addEventListener('click', () => stepState(lastStateAction, true))
      $('#reset-state').addEventListener('click', async () => { state = { items: [] }; await store.set('queue', state); renderState(); setStatus($('#state-status'), '已重置并保存') })
      $('#export-state').addEventListener('click', () => downloadText('queue-state.json', JSON.stringify(state, null, 2), 'application/json'))
      $('#clear-local').addEventListener('click', async () => { await store.clear(); state = { items: [] }; renderState(); setStatus($('#state-status'), '本站本地数据已清除') })
    </script>
</NativePageFrame>
