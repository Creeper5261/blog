---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

const root = path.resolve('generated', 'site-data')
const [release, routesPayload, topicsPayload, toolManifests, pulsesPayload, contentIndex] = await Promise.all([
  readFile(path.join(root, 'release.json'), 'utf8').then(JSON.parse),
  readFile(path.join(root, 'routes.json'), 'utf8').then(JSON.parse),
  readFile(path.join(root, 'topics.json'), 'utf8').then(JSON.parse),
  readFile(path.join(root, 'tool-manifests.json'), 'utf8').then(JSON.parse),
  readFile(path.join(root, 'pulses.json'), 'utf8').then(JSON.parse),
  readFile(path.join(root, 'content-index.json'), 'utf8').then(JSON.parse)
])
const releasePath = release.cache.immutableReleasePath
const pulse = pulsesPayload.pulses[0] ?? null
const collections = topicsPayload.collections
const tools = toolManifests.tools
const siteRoutes = routesPayload.items.filter((item) => item.source === 'site-routes')
const memberCount = collections.reduce((total, collection) => total + collection.members.length, 0)
const featured = [
  { title: '主题展厅', description: '按集合浏览主题成员与关系', href: '/topics/' },
  { title: '探索地图', description: '构建期预渲染的知识关系地图', href: '/explore/map/' },
  { title: '知识路径', description: '从集合与实体关系派生的阅读路径', href: '/paths/' },
  { title: '文字流', description: '把知识内容连成一条连续阅读流', href: '/flow/' },
  { title: '专题叙事', description: '按专题顺序讲述对象与关系', href: '/narratives/' },
  { title: '工具目录', description: 'manifest 驱动的本地优先工具', href: '/tools/' },
  { title: '本地实验台', description: 'S3 本地优先任务运行壳', href: '/lab/' },
  { title: 'Explain 教学回放', description: '同一 schema 的可步进解释单元', href: '/explain/' }
]
const blogLinks = [
  { title: '文章归档', href: '/archives/' },
  { title: '分类', href: '/categories/' },
  { title: '标签', href: '/tags/' },
  { title: '关于', href: '/about/' }
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="DAT 的博客与知识站：主题展厅、探索地图、知识路径、文字流、专题叙事与本地优先工具" />
    <title>DAT · 博客与知识站</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { max-width: 76rem; margin: 0 auto; padding: 2rem 1rem 4rem; line-height: 1.55; }
      h1 { margin: .1rem 0 .25rem; font-size: 2rem; }
      .lede, .muted { color: color-mix(in srgb, currentColor 72%, transparent); }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: .8rem; padding: 0; list-style: none; }
      .card { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: .7rem; padding: .9rem; }
      .card h2 { margin: 0 0 .3rem; font-size: 1.05rem; }
      .card a { color: inherit; text-decoration: none; }
      .card a:hover { text-decoration: underline; }
      .stats { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; margin: 1rem 0; }
      .stats span { border: 1px solid color-mix(in srgb, currentColor 24%, transparent); border-radius: 999px; padding: .2rem .7rem; font-size: .88rem; }
      .pulse { border-left: 3px solid color-mix(in srgb, currentColor 28%, transparent); padding: .2rem .8rem; margin: .5rem 0; }
      .routes, .blog { columns: 2 16rem; column-gap: 2rem; padding: 0; list-style: none; }
      .status { min-height: 1.5rem; }
      .error { color: #c62828; }
      @media (max-width: 48rem) { .cards { grid-template-columns: 1fr; } .routes, .blog { columns: 1; } }
    </style>
  </head>
  <body data-pulse-url={`${releasePath}pulses.json`}>
    <main>
      <p class="muted">个人博客 · 知识站 · 本地优先工具</p>
      <h1>DAT 的博客与知识站</h1>
      <p class="lede">静态站点承载可扩展知识：内容来自版本化 site-data，浏览器只读取发布后的 JSON；正文与导航始终由 Astro 预渲染。</p>

      <ul class="stats" aria-label="站点数据">
        <li><span>{contentIndex.items.length} 个对象</span></li>
        <li><span>{collections.length} 个主题集合</span></li>
        <li><span>{memberCount} 个集合成员</span></li>
        <li><span>{tools.length} 个本地工具</span></li>
      </ul>

      <h2>专题体验</h2>
      <ul class="cards">
        {featured.map((item) => (
          <li class="card">
            <h2><a href={item.href}>{item.title}</a></h2>
            <p class="muted">{item.description}</p>
          </li>
        ))}
      </ul>

      <h2>最新快照</h2>
      {pulse ? (
        <section id="pulse-preview" aria-label="热点快照">
          <p class="muted">{pulse.title} · 抓取于 {pulse.fetchedAt}</p>
          <ul class="cards">
            {pulse.items.slice(0, 3).map((item) => (
              <li class="card">
                <h2><a href={item.url} target="_blank" rel="noreferrer">{item.title}</a></h2>
                <p class="muted">{item.summary || '该项目没有摘要。'}</p>
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <p class="muted">暂无快照。</p>
      )}

      <h2>站点导航</h2>
      <ul class="routes">
        {siteRoutes.map((route) => (
          <li><a href={route.route}>{route.title}</a> <span class="muted">{route.route}</span></li>
        ))}
      </ul>

      <h2>博客与归档</h2>
      <ul class="blog">
        {blogLinks.map((link) => (
          <li><a href={link.href}>{link.title}</a></li>
        ))}
      </ul>

      <p id="status" class="status" role="status">以上内容来自当前版本化发布包。</p>
      <noscript><p class="muted">JavaScript 已禁用；页面内容已完整预渲染，仍可浏览全部入口。</p></noscript>
    </main>
    <script is:inline type="module">
      const status = document.querySelector('#status')
      const preview = document.querySelector('#pulse-preview')
      const url = document.body.dataset.pulseUrl
      if (url && preview) {
        try {
          const response = await fetch(url, { cache: 'force-cache' })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const payload = await response.json()
          const pulse = payload.pulses?.[0]
          if (pulse?.items?.length) {
            const list = document.createElement('ul'); list.className = 'cards'
            for (const item of pulse.items.slice(0, 3)) {
              const entry = document.createElement('li'); entry.className = 'card'
              const heading = document.createElement('h2')
              const link = document.createElement('a'); link.href = item.url; link.target = '_blank'; link.rel = 'noreferrer'; link.textContent = item.title
              heading.append(link)
              const summary = document.createElement('p'); summary.className = 'muted'; summary.textContent = item.summary || '该项目没有摘要。'
              entry.append(heading, summary); list.append(entry)
            }
            preview.replaceChildren(list)
            status.textContent = `已从版本化 JSON 更新快照；未访问在线来源。`
          }
        } catch (error) {
          status.classList.add('error')
          status.textContent = `版本化快照请求失败，保留预渲染内容：${error.message}`
        }
      }
    </script>
  </body>
</html>
