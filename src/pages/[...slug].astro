---
import { readFile } from 'node:fs/promises'
import path from 'node:path'

import { SITE_ROUTES } from '../../tools/site-data/routes.mjs'
import { applyPublicServices, getPublicServices } from '../legacy/html-transform.mjs'
import { listLegacyPages } from '../legacy/routes.mjs'

export async function getStaticPaths() {
  const legacyRoot = path.resolve('src', 'legacy', 'pages')
  const pages = await listLegacyPages(legacyRoot)
  const modernRouteSlugs = new Set(
    [...SITE_ROUTES, { route: '/tools/' }]
      .map((route) => route.route.replace(/^\/|\/$/g, ''))
      .filter(Boolean)
  )

  return pages
    .filter((page) => page.kind !== 'not-found' && page.kind !== 'home')
    .filter((page) => page.kind !== 'page' || !modernRouteSlugs.has(page.slug))
    .map((page) => ({
      params: { slug: page.slug },
      props: { outputPath: page.outputPath }
    }))
}

const legacyRoot = path.resolve('src', 'legacy', 'pages')
const { outputPath } = Astro.props
const html = await readFile(path.join(legacyRoot, outputPath), 'utf8')
const fragmentPath = path.resolve('source', 'content', 'renders', 'RMSNorm.html')
const renderedSource = html.includes('data-render-fragment="RMSNorm"')
  ? html.replace(
    /<div class="latex-document-rendered" data-render-fragment="RMSNorm"><\/div>/u,
    `<div class="latex-document-rendered"><article class="latex-preview-document">${await readFile(fragmentPath, 'utf8')}</article></div>`
  )
  : html
const rendered = applyPublicServices(renderedSource, getPublicServices())
---

<Fragment set:html={rendered} />
