---
import ExperiencePage from '../../components/ExperiencePage.astro'

const collections = []
---

<ExperiencePage title="DAT · 知识库" description="DAT 的个人知识库" active="knowledge">
  <section class="reading-page" aria-labelledby="knowledge-title">
    <header class="reading-heading">
      <p class="experience-eyebrow">DAT / 知识库</p>
      <h1 id="knowledge-title">把想记住的东西放在一起</h1>
      <p>这里是可阅读的主题入口，不展示索引结构和构建细节。按主题浏览，找到一条适合现在的阅读线索。</p>
    </header>

    <div class="reading-toolbar">
      <input class="reading-filter" id="topic-filter" type="search" placeholder="筛选主题" aria-label="筛选主题" />
    </div>

    {collections.length > 0 ? (
      <ul class="reading-list" id="topic-list">
        {collections.map((collection) => (
          <li class="reading-row" data-search={`${collection.title} ${collection.kind} ${collection.members.map((member) => member.title).join(' ')}`}>
            <div class="reading-row-main">
              <span class="reading-row-label">{collection.kind}</span>
              <h2>{collection.title}</h2>
              <p>{collection.members.slice(0, 4).map((member) => member.title).join(' · ') || '这个主题还没有成员。'}</p>
              <div class="reading-meta"><span>{collection.members.length} 个成员</span><span>更新于 {collection.updatedAt}</span></div>
            </div>
            <a class="reading-row-action" href={`/topics/#topic-${collection.id}`}>查看主题 →</a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="reading-status">暂时还没有主题。</p>
    )}

    <p class="reading-status" id="topic-status" role="status">{collections.length} 个主题</p>
    <p class="reading-noscript"><noscript>JavaScript 已禁用；主题列表仍可完整阅读。</noscript></p>
    <p class="reading-status"><a href="/pulse/">去看最新热点 →</a></p>
  </section>

  <script is:inline type="module">
    const filter = document.querySelector('#topic-filter')
    const rows = [...document.querySelectorAll('#topic-list .reading-row')]
    const status = document.querySelector('#topic-status')
    filter?.addEventListener('input', () => {
      const query = filter.value.trim().toLowerCase()
      let visible = 0
      rows.forEach((row) => { const match = !query || row.dataset.search.toLowerCase().includes(query); row.hidden = !match; if (match) visible += 1 })
      if (status) status.textContent = `${visible} 个主题`
    })
  </script>
</ExperiencePage>
